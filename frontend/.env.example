# Optional frontend API override.
# For local development, the app defaults to http://localhost:3002/api.
VITE_API_URL=http://localhost:3002/api

# For the Vercel multi-service deployment, leave VITE_API_URL unset so the
# frontend uses the same-origin /api route to the backend service.
# For separate Cloudflare Pages deployments, point it at the public API URL:
# VITE_API_URL=https://api.your-tqi-domain.org/api
