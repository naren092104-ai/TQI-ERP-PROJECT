# ──────────────────────────────────────────────────
# Frontend — Example env (commit this, NOT the real .env files)
# ──────────────────────────────────────────────────
# Local: /api (Vite dev-server proxy to backend)
# Production: absolute URL to the backend API server
#
# IMPORTANT: variable MUST start with VITE_ or Vite will NOT expose it.
# In Cloudflare Pages dashboard, set this exact variable name:
#   VITE_API_URL = https://tqi.autorevives.com/api
VITE_API_URL=https://YOUR-NODE-BACKEND.example.com/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
