# Backend environment template. Copy to backend/.env and replace placeholders.
PORT=3002
DB_HOST=localhost
DB_PORT=3306
DB_NAME=TQI_ERP
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_SSL=false
# Optional PEM CA certificate for TLS verification.
# If stored on one line, use literal \n between certificate lines.
# Never disable certificate verification in production.
DB_SSL_CA=
# Set false when the managed database/user cannot create databases.
DB_CREATE_IF_MISSING=true
JWT_SECRET=replace-with-a-long-random-secret
UPLOADS_DIR=backend/storage/uploads
APP_URL=http://localhost:5173

# SMTP / Email Configuration (optional for OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_FROM=noreply@example.com
SMTP_PASS=your_smtp_app_password
