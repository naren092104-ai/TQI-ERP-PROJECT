# Backend environment template. Copy to backend/.env and replace placeholders.
# For local-only MySQL development, use DB_HOST=localhost, DB_PORT=3306,
# DB_SSL=false and a local DB_USER/DB_PASSWORD in your untracked .env file.
NODE_ENV=development
PORT=5000
DB_HOST=your-tidb-public-endpoint
DB_PORT=4000
DB_NAME=tqi_erp
DB_USER=your_tidb_user
DB_PASSWORD=replace_with_tidb_password
DB_SSL=true
# Paste the TiDB Cloud CA certificate PEM. If stored on one line, use literal \n between lines.
# TLS certificate verification remains enabled; do not set DB_SSL=false in production.
DB_SSL_CA=replace_with_tidb_ca_pem
# Production must use false; provision the database/schema before connecting.
DB_CREATE_IF_MISSING=false
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000
# Optional in development (a stable local secret is generated automatically).
# Required in production: use a unique secret of at least 32 characters.
JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=
UPLOADS_DIR=backend/storage/uploads
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=1

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=

# SMTP / Email Configuration (required for production OTP, reset, and credential emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_PASS=
SMTP_TEST_RECIPIENT=
