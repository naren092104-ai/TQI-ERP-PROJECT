{
  "name": "tqi-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "prestart": "npm run build",
    "start": "node dist/server.cjs",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/server.cjs --tsconfig=tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:init": "tsx -e \"import('./src/db/connection.js').then(m => m.initializeDatabase()).then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "db:reset": "tsx src/scripts/resetDatabase.ts",
    "db:clean": "tsx src/scripts/cleanReset.ts"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.4",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "qs": "6.16.2"
  }
}
