# Backend environment template. Copy to backend/.env or the repository root.
NODE_ENV=production
PORT=5000
JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=

# Existing Node-compatible backend database variables (legacy MySQL cutover)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_SSL_CA=
DB_CREATE_IF_MISSING=false

# Supabase server configuration — never expose service key in Vite/browser code
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_PASS=
SMTP_TEST_RECIPIENT=

# Hosting
CORS_ORIGINS=https://YOUR-PAGES-SUBDOMAIN.pages.dev
APP_URL=https://YOUR-PAGES-SUBDOMAIN.pages.dev
FRONTEND_URL=https://YOUR-PAGES-SUBDOMAIN.pages.dev
TRUST_PROXY_HOPS=1
UPLOADS_DIR=/tmp/tqi-uploads

# Cloudflare Pages build-time variable
VITE_API_URL=https://YOUR-NODE-BACKEND.example.com/api
