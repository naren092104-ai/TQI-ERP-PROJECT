# Backend environment template. Copy to backend/.env or the repository root.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=TQI_ERP
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=
DB_CREATE_IF_MISSING=true
JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=
UPLOADS_DIR=backend/storage/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP / Email Configuration (optional for OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_FROM=noreply@example.com
SMTP_PASS=your_smtp_app_password

# Vite reads frontend/.env (see frontend/.env.example); only VITE_* values
# belong in the frontend build environment. Never put backend secrets there.
